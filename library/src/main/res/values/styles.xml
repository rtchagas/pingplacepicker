<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="PingThemeBase" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>

        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryDark</item>
        <item name="colorAccent">@color/colorSecondary</item>

        <item name="colorSurface">@color/colorSurface</item>

        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>

        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>
    </style>

    <style name="PingTheme" parent="PingThemeBase" />

    <style name="PingTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">?attr/colorOnPrimarySurface</item>
        <item name="actionMenuTextColor">?attr/colorOnPrimarySurface</item>
    </style>

    <style name="PingTheme.NoStatus">
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="PingToolbarStyle" parent="Widget.MaterialComponents.Toolbar.Surface">
        <!-- Toolbar should always be within an AppBarLayout which provides the background. -->
        <item name="android:background">@null</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="titleTextColor">?attr/colorOnPrimarySurface</item>
    </style>

    <style name="PingIcon">
        <item name="android:layout_width">@dimen/icon_size_small</item>
        <item name="android:layout_height">@dimen/icon_size_small</item>
        <item name="android:alpha">0.54</item>
    </style>

    <style name="PingIcon.OnPrimary">
        <item name="android:tint">?attr/colorOnPrimary</item>
    </style>

    <style name="PingIcon.OnSurface">
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="PingIcon.OnPrimarySurface">
        <item name="android:tint">?attr/colorOnPrimarySurface</item>
    </style>

    <style name="PingIcon.Secondary">
        <item name="android:alpha">1</item>
        <item name="android:tint">?attr/colorSecondary</item>
    </style>

    <!--
      Theme applied to the Places Autocomplete (New) widget via
      AutocompleteUiCustomization so its full-screen search screen matches the
      picker's palette. Only the color tokens that visibly deviate from the
      default are overridden; typography/spacing/corners keep Google's defaults.
      Token reference:
      https://developers.google.com/maps/documentation/places/android-sdk/widget-customization
    -->
    <style name="PingTheme.PlacesAutocomplete" parent="PlacesMaterialTheme">
        <!-- Screen / input surfaces -->
        <item name="placesColorSurface">@color/colorSurface</item>
        <item name="placesColorOnSurface">@color/colorOnSurface</item>
        <item name="placesColorOnSurfaceVariant">@color/textColorSecondary</item>

        <!-- Prediction rows -->
        <item name="placesColorNeutralContainer">@color/colorSurface</item>
        <item name="placesColorOnNeutralContainer">@color/colorOnSurface</item>
        <item name="placesColorOnNeutralContainerVariant">@color/textColorSecondary</item>

        <!-- Interactive accents (cursor, progress, primary button) -->
        <item name="placesColorPrimary">@color/colorSecondary</item>
        <item name="placesColorPrimaryContainer">@color/colorSecondaryDark</item>
        <item name="placesColorOnPrimaryContainer">@color/colorOnSecondary</item>

        <!-- Title typography to match the PING's search card -->
        <item name="placesTextAppearanceTitleSmall">@style/TextAppearance.MaterialComponents.Subtitle2</item>
        <item name="placesTextAppearanceTitleMedium">@style/TextAppearance.MaterialComponents.Subtitle2</item>
        <item name="placesTextAppearanceTitleLarge">@style/TextAppearance.MaterialComponents.Subtitle1</item>
    </style>

</resources>
